{
  "name": "chdb-d",
  "authors": ["Sergei Giniatulin"],
  "copyright": "Copyright © 2025, Sergei Giniatulin",
  "description": "chDB bindigs for D",
  "license": "MIT",
  "sourcePaths": ["source"],
  "configurations": [
    {
      "name": "dynamicBuild",
      "targetType": "library",
      "copyFiles": ["lib_files"],
      "lflags-posix": ["-ldl"],
      "dflags-ldc": ["-mcpu=native"],
      "versions": ["dynamicVersion"]
    },
    {
      "name": "staticBuild",
      "targetType": "staticLibrary",
      "copyFiles": ["lib_files"],
      "lflags-posix": ["lib_files/libchdb.a"],
      "dflags-ldc": ["-mcpu=native"],
      "versions": ["staticVersion"]
    }
  ]
}
